# Copy to .env and fill in the values you need.
# The app runs offline with the defaults below.

# mock | openai | faster_whisper
TRANSCRIPTION_PROVIDER=mock

# mock | openai
SUMMARIZATION_PROVIDER=mock

# Required only when a provider above is set to openai.
OPENAI_API_KEY=

# Optional OpenAI-compatible API root.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_SUMMARY_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# Used when TRANSCRIPTION_PROVIDER=faster_whisper.
# Install the extra first: pip install faster-whisper
FASTER_WHISPER_MODEL=base
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

# Maximum upload size in bytes (default 25 MiB).
MAX_UPLOAD_BYTES=26214400
